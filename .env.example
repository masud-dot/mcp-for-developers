# Copy to .env and fill in. Every variable is prefixed MCPDEV_.

# Required by the capstone. MUST be identical across every replica.
MCPDEV_HANDLE_KEY=
MCPDEV_REQUEST_STATE_KEY=
MCPDEV_AUTH_SIGNING_KEY=

# Chapter 10 — repository server
MCPDEV_REPO_API_BASE=https://api.github.com
MCPDEV_REPO_TOKEN=
MCPDEV_REPO_TIMEOUT_SECONDS=10.0

# Chapter 11 — build-history server
MCPDEV_CI_DB_PATH=builds.db
MCPDEV_HANDLE_TTL_SECONDS=900

# Chapter 18 — deployment
MCPDEV_ENVIRONMENT=development
MCPDEV_ALLOWED_HOSTS=["127.0.0.1:8000","localhost:8000"]
MCPDEV_ALLOWED_ORIGINS=[]
MCPDEV_READINESS_PROBE_URL=

# Chapter 20 — authorization
MCPDEV_AUTH_ISSUER=https://auth.example.com
MCPDEV_AUTH_AUDIENCE=https://mcp.example.com
MCPDEV_AUTH_ALGORITHM=HS256

# Chapter 25 — observability
MCPDEV_OTLP_ENDPOINT=
MCPDEV_LOG_LEVEL=INFO
